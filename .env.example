# Copy to .env. These are the only keys needed by scripts/quickstart.py.
# Choose models, agents, search and limits in that script's CONFIG block.
DEEPSEEK_API_KEY=
EXA_API_KEY=

# KubeTEE API (llm.kubetee.ai) — OpenAI-compatible TEE gateway.
# Route any model through it with the "kubetee/" prefix (stripped before the
# call): "kubetee/deepseek/deepseek-v4.1-flash", "kubetee/z-ai/glm-5.3-flash",
# "kubetee/ornith/ornith-1.5-397b", "kubetee/xiaomi/mimo-v2.6-pro", ...
KUBETEE_API_KEY=your-kubetee-key
# Optional overrides (defaults shown):
# KUBETEE_API_BASE=https://llm.kubetee.ai/v1

# Only if you choose an OpenRouter model or enable OpenRouter routing:
# OPENROUTER_API_KEY=

# If web_search_engine="tavily" or "both":
# TAVILY_API_KEY=

# If web_search_engine="desearch" or "all" (Bittensor SN22) — web/social
# search + page extraction. This one key also covers the Reddit fallback
# (no Reddit OAuth needed) and the arXiv fallback.
DESEARCH_API_KEY=your-desearch-key
# Optional override (default shown):
# DESEARCH_BASE_URL=https://api.desearch.ai

# If ResearchReddit is enabled:
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USERNAME=
# REDDIT_PASSWORD=

# If ResearchSubstack is enabled (Perplexity-backed search):
# PERPLEXITY_API_KEY=

# Contact details for specialist agents:
# PUBMED_EMAIL=
# SEC_EDGAR_CONTACT_EMAIL=
